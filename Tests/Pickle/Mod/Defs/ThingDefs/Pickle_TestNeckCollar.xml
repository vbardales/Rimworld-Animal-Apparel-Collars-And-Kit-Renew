<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- Test-only collar, never shipped: the shipped dog collars restrict species, so they cannot exercise
       the AnimalNeck fallback for bodies without a Neck part (snake, insect). This one lists a snake and
       a megaspider. It reuses the shipped abstract parent and the leather collar's sprites. -->
  <ThingDef ParentName="DogCollarBase">
    <defName>Pickle_TestNeckCollar</defName>
    <label>pickle test neck collar</label>
    <description>Test-only. Fits a snake and a megaspider to check the AnimalNeck fallback.</description>
    <statBases>
      <WorkToMake>1000</WorkToMake>
      <MaxHitPoints>50</MaxHitPoints>
      <Mass>0.1</Mass>
    </statBases>
    <costStuffCount>25</costStuffCount>
    <apparel>
      <tags>
        <li>AnimalApparel</li>
        <li>AnimalOnly</li>
        <li>AnimalFallbackInvisible</li>
        <li>defNameCobra</li>
        <li>defNameMegaspider</li>
      </tags>
      <bodyPartGroups>
        <li>AnimalNeck</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Animal/Apparel/Accessories/LeatherDogCollar</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
      </layers>
    </apparel>
  </ThingDef>
</Defs>
