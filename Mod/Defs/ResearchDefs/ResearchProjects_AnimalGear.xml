<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- From "Animal Equipment" by Owlchemist (Workshop 2568865984, last supported 1.4; MIT,
       github.com/Owlchemist/animal-equipment), itself a continuation of jptrrs's
       "Animal Armor: Vanilla".

       Owlchemist's chain had five projects: riding gear, animal clothing, then plate ->
       flak -> powered animal armour. Only three come across, because Animal Apparel: Basic
       Armor now provides the plate and flak pieces and gates them on the vanilla PlateArmor
       and FlakArmor research instead. PoweredAnimalArmor therefore hangs off vanilla
       PoweredArmor plus ComplexAnimalClothing rather than off the removed FlakAnimalArmor,
       and researchViewX is renumbered so the row has no gaps.

       The defNames are Owlchemist's, unchanged. Nothing else on the Workshop declares them
       (checked across the installed collection), and keeping them means anyone who had
       Animal Equipment researched keeps it. -->

  <ResearchTabDef>
    <defName>AnimalGear</defName>
    <label>animal gear</label>
  </ResearchTabDef>

  <ResearchProjectDef>
    <defName>AnimalRidingGear</defName>
    <label>riding gear</label>
    <tab>AnimalGear</tab>
    <description>Craft new equipment designs aimed to improve animal riding.</description>
    <baseCost>500</baseCost>
    <techLevel>Neolithic</techLevel>
    <researchViewX>0</researchViewX>
    <researchViewY>1</researchViewY>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>ComplexAnimalClothing</defName>
    <label>animal clothing</label>
    <tab>AnimalGear</tab>
    <description>Adapt complex clothing to fit onto a variety of domestic animals.</description>
    <baseCost>750</baseCost>
    <techLevel>Medieval</techLevel>
    <prerequisites>
      <li>ComplexClothing</li>
    </prerequisites>
    <researchViewX>1</researchViewX>
    <researchViewY>1</researchViewY>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>PoweredAnimalArmor</defName>
    <label>power armored animals</label>
    <tab>AnimalGear</tab>
    <description>Craft high tech power armor made to fit onto domestic animals.</description>
    <baseCost>8000</baseCost>
    <techLevel>Spacer</techLevel>
    <prerequisites>
      <li>PoweredArmor</li>
      <li>ComplexAnimalClothing</li>
    </prerequisites>
    <researchViewX>2</researchViewX>
    <researchViewY>1</researchViewY>
  </ResearchProjectDef>

</Defs>
