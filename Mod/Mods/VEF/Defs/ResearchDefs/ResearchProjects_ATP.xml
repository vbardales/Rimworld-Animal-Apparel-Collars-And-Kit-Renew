<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- From "Animal Turret Packs" by flangopink and ogam. Unchanged except that the
       ResearchTabDef AnimalGear the original declared alongside these is not repeated here -
       it lives in Defs/ResearchDefs/ResearchProjects_AnimalGear.xml, outside this gated
       folder, so the tab exists whether or not Vanilla Expanded Framework is running.

       researchViewY 2 keeps this row below the Animal Equipment row at Y 1, as both mods
       intended when they shared the tab. -->

  <ResearchProjectDef>
    <defName>ATP_Weapons</defName>
    <label>weaponized animals</label>
    <tab>AnimalGear</tab>
    <description>Adapt existing weapon designs into turret packs specially made for animals.</description>
    <baseCost>1000</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>BlowbackOperation</li>
    </prerequisites>
    <researchViewX>3</researchViewX>
    <researchViewY>2</researchViewY>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>ATP_Charge</defName>
    <label>animal charge weapons</label>
    <tab>AnimalGear</tab>
    <description>Craft high tech charge weapons made to fit onto domestic animals.</description>
    <baseCost>3000</baseCost>
    <techLevel>Spacer</techLevel>
    <prerequisites>
      <li>ChargedShot</li>
      <li>ATP_Weapons</li>
    </prerequisites>
    <researchViewX>4</researchViewX>
    <researchViewY>2</researchViewY>
  </ResearchProjectDef>

</Defs>
